{
  "expo": {
    "name": "Purrfolio",
    "slug": "purrfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "purrfolio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.purrfolio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#b5f0dc",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.purrfolio.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./modules/notification-listener/plugin/index.js",
      "expo-font",
      "expo-local-authentication",
      [
        "expo-build-properties",
        {
          "android": {
            "gradleVersion": "8.13"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-transparent.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://lpwvzzagbvxybhwwttgn.supabase.co",
      "supabaseAnonKey": "sb_publishable_lcarFtcbX7gk3qCvXS-PIQ_UEJLfGOS",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0e5c9941-5cf2-43ce-ad20-fc8ad6a1562e"
      }
    },
    "owner": "cataflame"
  }
}
