{
  "expo": {
    "name": "Purrfolio",
    "slug": "purrfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "purrfolio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.purrfolio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f4ef",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.purrfolio.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f4ef"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://lpwvzzagbvxybhwwttgn.supabase.co",
      "supabaseAnonKey": "sb_publishable_lcarFtcbX7gk3qCvXS-PIQ_UEJLfGOS",
      "router": {
        "origin": false
      }
    }
  }
}
